<UserControl x:Class="iceman_gui.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <!-- ============================================================== -->
        <!-- VIEW 1: Main Dashboard (Expanded Connection Card + CardActions) -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource FluentEntranceStyle}"
                      Visibility="{Binding IsShowingMainDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="24">
                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <ui:TextBlock Text="Device Dashboard" FontTypography="Title" />
                    <ui:TextBlock Text="Manage Proxmark3 serial connection and device status." 
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Serial Port Connection Card (Always expanded) -->
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="UsbPlug24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Serial Port Connection" FontTypography="Subtitle" />
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Text="COM Port:" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Margin="0,0,12,0" />
                            <ui:Button Grid.Column="2" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshPortsCommand}" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <ui:Button Content="Connect" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Disconnect" Icon="{ui:SymbolIcon PlugDisconnected24}" Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar IsOpen="True" Severity="Informational" Message="{Binding StatusMessage}" IsClosable="False" />
                    </StackPanel>
                </ui:Card>

                <!-- Action 1: Hardware Specs (Windows 11 Settings pattern with chevron) -->
                <ui:CardAction Command="{Binding ShowHardwareDetailsCommand}"
                               IsChevronVisible="True"
                               Margin="0,0,0,12"
                               Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DeveloperBoard24" 
                                       FontSize="22" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                       Margin="0,0,16,0" 
                                       VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Hardware Specs" FontTypography="BodyStrong" FontSize="14" />
                            <ui:TextBlock Text="Physical microcontroller architecture, SRAM/Flash memory, and LF/HF antenna tuning." 
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                          FontSize="12" 
                                          Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>

                <!-- Action 2: OS Specs & Flasher (Windows 11 Settings pattern with chevron) -->
                <ui:CardAction Command="{Binding ShowOsDetailsCommand}"
                               IsChevronVisible="True"
                               Margin="0,0,0,20"
                               Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Flash24" 
                                       FontSize="22" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                       Margin="0,0,16,0" 
                                       VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="OS Specs" FontTypography="BodyStrong" FontSize="14" />
                            <ui:TextBlock Text="ARM operating system, bootloader, FPGA bitstreams, and firmware flasher." 
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                          FontSize="12" 
                                          Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </ui:CardAction>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- VIEW 2: Hardware Specs Sub-page (Microcontroller & Antennas)    -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource FluentEntranceStyle}"
                      Visibility="{Binding IsShowingHardwareDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="24">
                <!-- Navigation Back Button -->
                <ui:Button Content="Back to Dashboard" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" Command="{Binding BackToDashboardCommand}" Margin="0,0,0,16" HorizontalAlignment="Left" />

                <!-- Sub-page Header -->
                <StackPanel Margin="0,0,0,20">
                    <ui:TextBlock Text="Hardware Specs" FontTypography="Title" />
                    <ui:TextBlock Text="Physical microcontroller details, internal memory architecture, and antenna resonance." 
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Card 1: Microcontroller & Physical Architecture -->
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Microcontroller &amp; Physical Architecture" FontTypography="Subtitle" />
                        </StackPanel>

                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,6">
                                <ui:TextBlock Text="Microcontroller (uC)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.Processor, FallbackValue='Not Connected'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,6">
                                <ui:TextBlock Text="Embedded Processor Core" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.EmbeddedProcessor, FallbackValue='ARM7TDMI'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8">
                                <ui:TextBlock Text="Architecture Identifier" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.Architecture, FallbackValue='-'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8">
                                <ui:TextBlock Text="Hardware Model" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.Model, FallbackValue='-'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6">
                                <ui:TextBlock Text="Internal SRAM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.SramSize, FallbackValue='-'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                                <ui:TextBlock Text="Embedded Flash Memory" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.FlashMemory, FallbackValue='-'}" FontTypography="BodyStrong" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Card 2: Antenna Tuning (hw tune) -->
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BroadActivityFeed24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                <ui:TextBlock Text="Antenna Tuning (hw tune)" FontTypography="Subtitle" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                                                 Visibility="{Binding MeasureAntennaCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:Button Content="Measure Antenna" Icon="{ui:SymbolIcon Play24}" Command="{Binding MeasureAntennaCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LF -->
                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="16" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <StackPanel>
                                    <ui:TextBlock Text="LF Antenna (125 kHz)" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Hardware.LfVoltage, StringFormat='{}{0:F2} V', FallbackValue='0.00 V'}" FontSize="24" FontWeight="Bold" Margin="0,6" />
                                    <ui:TextBlock Text="{Binding Hardware.LfTuneStatus}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- HF -->
                            <Border Grid.Column="1" Margin="8,0,0,0" Padding="16" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <StackPanel>
                                    <ui:TextBlock Text="HF Antenna (13.56 MHz)" FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding Hardware.HfVoltage, StringFormat='{}{0:F2} V', FallbackValue='0.00 V'}" FontSize="24" FontWeight="Bold" Margin="0,6" />
                                    <ui:TextBlock Text="{Binding Hardware.HfTuneStatus}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- VIEW 3: OS Specs Sub-page (Operating System & Firmware Flasher) -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource FluentEntranceStyle}"
                      Visibility="{Binding IsShowingOsDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="24">
                <!-- Navigation Back Button -->
                <ui:Button Content="Back to Dashboard" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" Command="{Binding BackToDashboardCommand}" Margin="0,0,0,16" HorizontalAlignment="Left" />

                <!-- Sub-page Header -->
                <StackPanel Margin="0,0,0,20">
                    <ui:TextBlock Text="OS Specs" FontTypography="Title" />
                    <ui:TextBlock Text="ARM operating system, bootloader, compiler builds, FPGA bitstreams, and firmware flasher." 
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Card 1: Operating System & Firmware Details -->
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Operating System &amp; Firmware Details" FontTypography="Subtitle" />
                        </StackPanel>

                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,6">
                                <ui:TextBlock Text="ARM OS Build" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.OsVersion, FallbackValue='Not Connected'}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,6">
                                <ui:TextBlock Text="ARM Bootloader" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.BootromVersion, FallbackValue='-'}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8">
                                <ui:TextBlock Text="OS Compiler" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.OsCompiler, FallbackValue='-'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8">
                                <ui:TextBlock Text="Client Build" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.ClientVersion, FallbackValue='-'}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6">
                                <ui:TextBlock Text="Client Compiler &amp; Platform" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.ClientCompiler, FallbackValue='-'}" />
                                <ui:TextBlock Text="{Binding Hardware.Platform, FallbackValue=''}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                                <ui:TextBlock Text="FPGA Bitstreams" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding Hardware.FpgaBuild, FallbackValue='fpga_pm3_hf.ncd (2s30vq100)'}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Card 2: Firmware Flasher (Consolidated Flasher Card) -->
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Firmware Flasher" FontTypography="Subtitle" />
                        </StackPanel>

                        <!-- Binary Readiness Status -->
                        <ui:InfoBar IsOpen="True" 
                                    Severity="{Binding Flasher.FirmwareSeverity}" 
                                    Message="{Binding Flasher.FirmwareStatusText}" 
                                    IsClosable="False" 
                                    Margin="0,0,0,14" />

                        <!-- Start Flashing Action -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:Button Content="Start Flashing Firmware" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" 
                                       Command="{Binding Flasher.FlashCommand}" IsEnabled="{Binding Flasher.CanFlash}" Margin="0,0,12,0" />
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,12,0"
                                             Visibility="{Binding Flasher.IsFlashing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ProgressBar Width="140" Height="6" IsIndeterminate="{Binding Flasher.IsFlashing}" Visibility="{Binding Flasher.IsFlashing, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Sections shown after flashing execution starts -->
                        <StackPanel Visibility="{Binding Flasher.HasFlashingStarted, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,14,0,0">
                            <!-- Process Log -->
                            <ui:TextBlock Text="Flash Execution Log" FontTypography="BodyStrong" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Flasher.FlashLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="#111111" Foreground="#00FF66" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                            <!-- Emergency Recovery Guide Link & Tips -->
                            <Border Padding="14" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock Text="Emergency Recovery &amp; Unbricking Guide" FontTypography="BodyStrong" />
                                        <ui:TextBlock Text="If your Proxmark3 is unresponsive or flashing was interrupted, consult the official recovery guide." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Open Recovery Guide (Web)" Icon="{ui:SymbolIcon Open24}" Command="{Binding Flasher.OpenRecoveryGuideCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
