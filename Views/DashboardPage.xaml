<UserControl x:Class="iceman_gui.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="Device Dashboard" FontTypography="Title" />
                <ui:TextBlock Text="Manage Proxmark3 serial connection, inspect hardware details, and tune antenna." 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Connection Card -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="UsbPort24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Serial Port Connection" FontTypography="Subtitle" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Text="COM Port:" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Margin="0,0,12,0" />
                        <ui:Button Grid.Column="2" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshPortsCommand}" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <ui:Button Content="Connect" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Disconnect" Icon="{ui:SymbolIcon PlugDisconnected24}" Command="{Binding DisconnectCommand}" />
                        </StackPanel>
                    </Grid>

                    <ui:InfoBar IsOpen="True" Severity="Informational" Message="{Binding StatusMessage}" IsClosable="False" />
                </StackPanel>
            </ui:Card>

            <!-- Hardware Details Card -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Hardware &amp; Firmware Specs" FontTypography="Subtitle" />
                    </StackPanel>

                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4">
                            <ui:TextBlock Text="Firmware Model" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding Hardware.Model, FallbackValue='Not Connected'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                            <ui:TextBlock Text="Microcontroller / ARM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding Hardware.Processor, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8">
                            <ui:TextBlock Text="Client Version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding Hardware.ClientVersion, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8">
                            <ui:TextBlock Text="Flash Memory" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding Hardware.FlashMemory, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4">
                            <ui:TextBlock Text="ARM Bootrom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding Hardware.BootromVersion, FallbackValue='-'}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <ui:TextBlock Text="ARM OS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding Hardware.OsVersion, FallbackValue='-'}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Antenna Tuning Card -->
            <ui:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BroadActivityFeed24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Antenna Tuning (hw tune)" FontTypography="Subtitle" />
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" Content="Measure Antenna" Icon="{ui:SymbolIcon Play24}" Command="{Binding MeasureAntennaCommand}" />
                    </Grid>

                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LF -->
                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="16" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                            <StackPanel>
                                <ui:TextBlock Text="LF Antenna (125 kHz)" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{Binding Hardware.LfVoltage, StringFormat='{}{0:F2} V', FallbackValue='0.00 V'}" FontSize="24" FontWeight="Bold" Margin="0,6" />
                                <ui:TextBlock Text="{Binding Hardware.LfTuneStatus}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- HF -->
                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="16" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8">
                            <StackPanel>
                                <ui:TextBlock Text="HF Antenna (13.56 MHz)" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{Binding Hardware.HfVoltage, StringFormat='{}{0:F2} V', FallbackValue='0.00 V'}" FontSize="24" FontWeight="Bold" Margin="0,6" />
                                <ui:TextBlock Text="{Binding Hardware.HfTuneStatus}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
