<UserControl x:Class="iceman_gui.Views.TagScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="Tag Scanner &amp; Identifier" FontTypography="Title" />
                <ui:TextBlock Text="One-click automatic RFID/NFC tag discovery, UID extraction, and hardware identity profiling." 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Actions Bar -->
            <ui:Card Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Quick Scan (1s)" Appearance="Primary" Icon="{ui:SymbolIcon Flashlight24}" Command="{Binding QuickScanCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Full HF &amp; LF Search" Icon="{ui:SymbolIcon Search24}" Command="{Binding FullScanCommand}" Margin="0,0,12,0" />
                        <ui:Button Content="Save Tag Info (JSON)" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveTagInfoCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="120" Height="6" IsIndeterminate="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Status Banner -->
            <ui:InfoBar IsOpen="True" Severity="Informational" Message="{Binding StatusMessage}" IsClosable="False" Margin="0,0,0,20" />

            <!-- MIFARE Classic Detected Banner & Quick Handoff -->
            <ui:Card Margin="0,0,0,20" Visibility="{Binding IsMifareCardDetected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Key24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="MIFARE Classic Toolkit Unlocked" FontTypography="BodyStrong" />
                        </StackPanel>
                        <ui:TextBlock Text="This card is compatible with key recovery, block reading, UID cloning, and data dumping." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="Open Mifare Toolkit" Appearance="Primary" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding GoToMifareCommand}" />
                </Grid>
            </ui:Card>

            <!-- Detected Tag Profile Card -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="ContactCard24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Detected Tag Profile" FontTypography="Subtitle" />
                    </StackPanel>

                    <!-- UID Big Display -->
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <ui:TextBlock Text="Card UID / CSN" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                <ui:TextBlock Text="{Binding CurrentTag.FormattedUid, FallbackValue='No Card Detected'}" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,4" />
                                <ui:TextBlock Text="{Binding CurrentTag.TagType, FallbackValue='Place card on antenna and click Scan'}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontTypography="BodyStrong" />
                            </StackPanel>

                            <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="Copy UID" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyUidCommand}" />
                        </Grid>
                    </Border>

                    <!-- Tag Specifications Grid -->
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,6">
                            <ui:TextBlock Text="Frequency" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Frequency, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,6">
                            <ui:TextBlock Text="ATQA" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Atqa, FallbackValue='-'}" FontFamily="Consolas" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,6">
                            <ui:TextBlock Text="SAK" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Sak, FallbackValue='-'}" FontFamily="Consolas" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6">
                            <ui:TextBlock Text="Magic Capabilities" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.MagicType, FallbackValue='Standard (Non-Magic)'}" FontTypography="BodyStrong" Foreground="LimeGreen" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6">
                            <ui:TextBlock Text="PRNG Detection" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Prng, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6">
                            <ui:TextBlock Text="LF Card / Facility Code" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.CardNumber, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Raw Terminal Output Expander -->
            <Expander Header="Raw Scanner Output" IsExpanded="False">
                <TextBox Text="{Binding CurrentTag.RawOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="#111111" Foreground="#00FF66" Height="180" VerticalScrollBarVisibility="Auto" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
