<UserControl x:Class="iceman_gui.Views.TagScannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <!-- ============================================================== -->
        <!-- VIEW 1: Main Tag Scanner View                                 -->
        <!-- ============================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource FluentEntranceStyle}">
            <StackPanel Margin="24">
                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <ui:TextBlock Text="Read Card" FontTypography="Title" />
                    <ui:TextBlock Text="Identify a card, then back it up to your card library."
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Empty state -->
                <Border Visibility="{Binding HasNoTag, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="24,32"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TagDismiss24" FontSize="40"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <ui:TextBlock Text="No card on the antenna"
                                      FontTypography="BodyStrong" FontSize="16"
                                      HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <ui:TextBlock Text="Place a card on the Proxmark3 and scan it."
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      FontSize="12"
                                      HorizontalAlignment="Center" />
                        <ui:Button Content="Scan Card"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Scan24}"
                                   Command="{Binding ScanCardCommand}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <ProgressBar Width="120" Height="6" IsIndeterminate="{Binding IsScanning}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card information -->
                <StackPanel Visibility="{Binding HasCurrentTag, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <ProgressBar Width="100" Height="6" IsIndeterminate="{Binding IsScanning}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                        <ui:Button Content="Scan Card" Appearance="Primary" Icon="{ui:SymbolIcon Scan24}"
                                   Command="{Binding ScanCardCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Clear Card" Appearance="Secondary" Icon="{ui:SymbolIcon Dismiss24}"
                                   Command="{Binding ClearCardCommand}" />
                    </StackPanel>

                    <!-- UID banner -->
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="16" CornerRadius="8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:TextBlock Text="Card UID / CSN"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                            Visibility="{Binding CurrentTag.HasStandard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:TextBlock Text="{Binding CurrentTag.Standard}" FontSize="11"
                                                      Foreground="White" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <ui:TextBlock Text="{Binding CurrentTag.FormattedUid, FallbackValue='No Card Detected'}"
                                              FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                              Margin="0,0,0,4" />

                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="{Binding CurrentTag.TagType, FallbackValue='Place card on antenna and click Scan'}"
                                                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                  FontTypography="BodyStrong" Margin="0,0,12,0" />
                                    <ui:TextBlock Text="{Binding CurrentTag.Manufacturer}"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  FontSize="12" VerticalAlignment="Center"
                                                  Visibility="{Binding CurrentTag.HasManufacturer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="140">
                                <ui:Button Content="Copy UID"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Command="{Binding CopyUidCommand}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,0,6" />
                                <ui:Button Content="Write New UID"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding OpenWriteUidDialogCommand}"
                                           Visibility="{Binding CanWriteUid, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           HorizontalAlignment="Stretch" />
                                <Border Visibility="{Binding CannotWriteUid, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,5"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Prohibited20" FontSize="14"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <ui:TextBlock Text="Write tag not supported" FontSize="11"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Specifications -->
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,6">
                            <ui:TextBlock Text="Standard / Make" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Standard, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,6">
                            <ui:TextBlock Text="Chip / Model" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.TagType, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,6">
                            <ui:TextBlock Text="IC Manufacturer" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Manufacturer, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6">
                            <ui:TextBlock Text="Frequency" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Frequency, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6">
                            <ui:TextBlock Text="UID Structure" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.UidLength, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6">
                            <ui:TextBlock Text="PRNG Detection" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Prng, FallbackValue='-'}" FontTypography="BodyStrong" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6">
                            <ui:TextBlock Text="ATQA" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Atqa, FallbackValue='-'}" FontFamily="Consolas" FontTypography="BodyStrong" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                            <ui:TextBlock Text="SAK" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Sak, FallbackValue='-'}" FontFamily="Consolas" FontTypography="BodyStrong" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,6">
                            <ui:TextBlock Text="Magic Capabilities" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.DisplayMagicType, FallbackValue='Standard (Non-Magic)'}"
                                          FontTypography="BodyStrong" Foreground="LimeGreen" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,6" Grid.ColumnSpan="2"
                                    Visibility="{Binding CurrentTag.HasAts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="Answer To Select (ATS)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.Ats}" FontFamily="Consolas" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{Binding CurrentTag.AtsDetails}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          FontSize="11" Margin="0,2,0,0"
                                          Visibility="{Binding CurrentTag.HasAtsDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,6"
                                    Visibility="{Binding CurrentTag.HasHistoricalBytes, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="Historical Bytes" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBlock Text="{Binding CurrentTag.HistoricalBytes}" FontFamily="Consolas" FontTypography="BodyStrong" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Backup -->
                <StackPanel Visibility="{Binding HasCurrentTag, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,16,0,0">
                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save24" FontSize="20"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Margin="0,0,8,0" />
                            <ui:TextBlock Text="Back up this card" FontTypography="Subtitle" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Content="Open Card Library"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding OpenLibraryCommand}"
                                   Visibility="{Binding HasBackupEntry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <ui:TextBlock Text="{Binding BackupHint}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding BackupAlias, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Name this backup (optional)"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1"
                                   Content="Back up card"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding BackupCardCommand}"
                                   IsEnabled="{Binding CanBackup}" />
                    </Grid>

                    <StackPanel Visibility="{Binding HasBackupStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar Height="4"
                                     IsIndeterminate="{Binding IsBackingUp}"
                                     Visibility="{Binding IsBackingUp, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,0,6" />
                        <ui:TextBlock Text="{Binding BackupStatus}"
                                      TextWrapping="Wrap"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- VIEW 3: Write New UID Modal Dialog                             -->
        <!-- ============================================================== -->
        <Grid Background="#B0000000"
              Visibility="{Binding IsWritingUidDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000">
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.75" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Write New UID" FontTypography="Subtitle" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding CloseWriteUidDialogCommand}" Padding="6" />
                    </Grid>

                    <ui:TextBlock Text="Directly program block 0 on modifiable MIFARE cards using auto-detected capabilities."
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,16" />

                    <!-- Current UID -->
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="Current UID:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ui:TextBlock Text="{Binding CurrentTag.FormattedUid}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-Detected Magic Capabilities Mode -->
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="14,10" CornerRadius="6" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ui:TextBlock Text="Detected Magic Mode" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding DetectedMagicModeText}" FontTypography="BodyStrong" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#064E3B" CornerRadius="4" Padding="8,4">
                                <ui:TextBlock Text="Auto-Selected" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- New UID Input with Random Button -->
                    <ui:TextBlock Text="New UID (4 bytes / 8 hex characters):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding WriteUidInput, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="Consolas"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    MaxLength="8"
                                    PlaceholderText="e.g. 11223344"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1"
                                   Content="Random"
                                   Icon="{ui:SymbolIcon Sparkle24}"
                                   Command="{Binding GenerateRandomUidCommand}"
                                   ToolTip="Generate random 4-byte UID" />
                    </Grid>

                    <!-- Status / Result Message -->
                    <Border Margin="0,0,0,16"
                            Padding="12,8"
                            CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasWriteUidResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,8,0"
                                             Visibility="{Binding IsWritingUid, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:TextBlock Text="{Binding WriteUidResult}"
                                          TextWrapping="Wrap"
                                          Foreground="{Binding WriteUidResultBrush}"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1"
                                   Content="Cancel"
                                   Appearance="Secondary"
                                   Command="{Binding CloseWriteUidDialogCommand}"
                                   Visibility="{Binding CanCancelWriteUid, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2"
                                   Content="{Binding WriteUidButtonText}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Checkmark24}"
                                   Command="{Binding ExecuteWriteUidCommand}"
                                   IsEnabled="{Binding IsNotWritingUid}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
