<UserControl x:Class="iceman_gui.Views.MifareToolkitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="MIFARE Classic Toolkit" FontTypography="Title" />
                <ui:TextBlock Text="Recover keys, dump all 16 sectors, inspect hex/ASCII data, and modify block 0 / UID on Gen 2 (CUID) or Gen 1a magic cards." 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Actions Bar -->
            <ui:Card Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Check Keys (chk)" Appearance="Primary" Icon="{ui:SymbolIcon Key24}" Command="{Binding CheckKeysCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Read All Blocks (Dump)" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ReadAllBlocksCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Export JSON" Icon="{ui:SymbolIcon DocumentSave24}" Command="{Binding SaveDumpJsonCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Export EML" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding SaveDumpEmlCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                        <ProgressBar Width="160" Height="6" Value="{Binding ProgressValue}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:InfoBar IsOpen="True" Severity="Informational" Message="{Binding StatusMessage}" IsClosable="False" Margin="0,0,0,20" />

            <!-- Modify UID & Magic Card Writing Card -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Modify Card Information (UID Change &amp; Magic Card Write)" FontTypography="Subtitle" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Text="New UID (4 bytes / 8 hex):" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ui:TextBox Grid.Column="1" Text="{Binding NewUidInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MaxLength="8" Margin="0,0,12,0" />
                        <CheckBox Grid.Column="2" Content="Gen 2 (CUID direct write)" IsChecked="{Binding IsGen2Cuid}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ui:Button Grid.Column="3" Content="Write New UID" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding ChangeUidCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Block Data Editor -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Table24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Selected Block Data Editor" FontTypography="Subtitle" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBlock Text="Block Data (32 hex / 16 bytes):" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ui:TextBox Grid.Column="1" Text="{Binding EditBlockDataHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" MaxLength="32" Margin="0,0,12,0" />
                        <ui:Button Grid.Column="2" Content="Write Block" Icon="{ui:SymbolIcon ArrowUpload24}" Command="{Binding WriteSelectedBlockCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 16 Sectors Data Viewer (Pure Fluent UI) -->
            <StackPanel Margin="0,0,0,20">
                <Grid Margin="0,0,0,12">
                    <ui:TextBlock Text="Sectors &amp; Blocks Matrix (MIFARE Classic 1K)" FontTypography="Subtitle" VerticalAlignment="Center" />
                    <ui:TextBlock Text="64 Blocks Total (16 Sectors x 4 Blocks)" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" FontSize="12" />
                </Grid>

                <ItemsControl ItemsSource="{Binding CardData.Sectors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardExpander IsExpanded="True" Margin="0,0,0,8">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" FontSize="14" Margin="0,0,10,0" />
                                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Visibility="{Binding SectorNumber, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <!-- If sector == 0 -->
                                            </Border>
                                        </StackPanel>

                                        <!-- Sector Keys & Access Bits Pills -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Key A Pill -->
                                            <Border Background="#0F2F1D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Key20" FontSize="14" Foreground="#22C55E" Margin="0,0,4,0" />
                                                    <ui:TextBlock Text="{Binding KeyA, StringFormat='{}Key A: {0}'}" FontFamily="Consolas" FontSize="11" Foreground="#4ADE80" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Access Bits Pill -->
                                            <Border Background="#2B2105" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Foreground="#EAB308" Margin="0,0,4,0" />
                                                    <ui:TextBlock Text="{Binding AccessBits, StringFormat='{}Access: {0}'}" FontFamily="Consolas" FontSize="11" Foreground="#FACC15" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Key B Pill -->
                                            <Border Background="#0C2340" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Key20" FontSize="14" Foreground="#3B82F6" Margin="0,0,4,0" />
                                                    <ui:TextBlock Text="{Binding KeyB, StringFormat='{}Key B: {0}'}" FontFamily="Consolas" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander.Header>

                                <!-- Pure Fluent UI Blocks List inside Expander -->
                                <ItemsControl ItemsSource="{Binding Blocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Padding="8,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Block Number Badge -->
                                                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <ui:TextBlock Text="{Binding BlockNumber, StringFormat='{}Blk {0:D2}'}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" />
                                                    </Border>

                                                    <!-- Block Type Indicator Tags -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding IsBlockZero, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ui:TextBlock Text="UID" Foreground="#34D399" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Visibility="{Binding IsSectorTrailer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ui:TextBlock Text="Trailer" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Hex Data in dark monospaced pill -->
                                                    <Border Grid.Column="2" Margin="6,0" Background="#141416" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                        <ui:TextBlock Text="{Binding FormattedHex}" FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- ASCII Preview in dark pill -->
                                                    <Border Grid.Column="3" Margin="0,0,6,0" Background="#141416" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                        <ui:TextBlock Text="{Binding DataAscii}" FontFamily="Consolas" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Edit & Copy Buttons -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit16}" Padding="8,4" FontSize="11" 
                                                                   Command="{Binding DataContext.EditBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                   CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                        <ui:Button Icon="{ui:SymbolIcon Copy16}" ToolTip="Copy 32-hex data" Padding="8,4" FontSize="11" 
                                                                   Command="{Binding DataContext.CopyHexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                   CommandParameter="{Binding DataHex}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
