<UserControl x:Class="iceman_gui.Views.MifareToolkitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Navigation Back Button -->
            <ui:Button Content="Back to Tag Scanner" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" Command="{Binding BackToScannerCommand}" Margin="0,0,0,16" HorizontalAlignment="Left" />

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="MIFARE Classic Toolkit" FontTypography="Title" />
                <ui:TextBlock Text="Recover keys, dump all 16 sectors, inspect hex/ASCII data, and modify block 0 / UID on Gen 2 (CUID) or Gen 1a magic cards." 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Actions Bar -->
            <ui:Card Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Check Keys (chk)" Appearance="Primary" Icon="{ui:SymbolIcon Key24}" Command="{Binding CheckKeysCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Read All Blocks (Dump)" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ReadAllBlocksCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Export JSON" Icon="{ui:SymbolIcon DocumentSave24}" Command="{Binding SaveDumpJsonCommand}" Margin="0,0,10,0" />
                        <ui:Button Content="Export EML" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding SaveDumpEmlCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,6,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <ProgressBar Width="160" Height="6" Value="{Binding ProgressValue}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Selected Block Data Editor Card -->
            <ui:Card Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Selected Block Data Editor" FontTypography="Subtitle" VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <ui:TextBlock Text="{Binding SelectedBlock.BlockNumber, StringFormat='{}Block {0:D2}', FallbackValue='No Block Selected'}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" 
                                    Text="{Binding EditBlockDataHex, UpdateSourceTrigger=PropertyChanged}" 
                                    FontFamily="Consolas" 
                                    FontSize="13"
                                    MaxLength="32" 
                                    PlaceholderText="Click 'Edit' on any block below to load hex data (32 hex characters / 16 bytes)" 
                                    Margin="0,0,10,0" 
                                    VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                                             Visibility="{Binding WriteSelectedBlockCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Content="Write Block" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding WriteSelectedBlockCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 16 Sectors Data Matrix (Compact High-Density Grid) -->
            <StackPanel Margin="0,0,0,20">
                <Grid Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Table24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Sectors &amp; Blocks Matrix (MIFARE Classic 1K)" FontTypography="Subtitle" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:TextBlock Text="64 Blocks Total (16 Sectors x 4 Blocks)" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" FontSize="12" />
                </Grid>

                <ItemsControl ItemsSource="{Binding CardData.Sectors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,6"
                                    Padding="10,6">
                                <StackPanel>
                                    <!-- Sector Slim Header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Consolas" FontSize="11">
                                                <Run Text="Key A: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding KeyA}" Foreground="#4ADE80" FontWeight="SemiBold" />
                                                <Run Text="   Access: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding AccessBits}" Foreground="#FACC15" FontWeight="SemiBold" />
                                                <Run Text="   Key B: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding KeyB}" Foreground="#60A5FA" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Compact Blocks Rows (4 blocks per sector) -->
                                    <ItemsControl ItemsSource="{Binding Blocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1" Padding="6,3" CornerRadius="4" Background="#141416">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Block Number -->
                                                        <ui:TextBlock Grid.Column="0" Text="{Binding BlockNumber, StringFormat='{}Blk {0:D2}'}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                                        <!-- Tag: UID / Trailer / Data -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Border Background="#064E3B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" Visibility="{Binding IsBlockZero, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ui:TextBlock Text="UID" Foreground="#34D399" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                            <Border Background="#1E3A8A" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" Visibility="{Binding IsSectorTrailer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ui:TextBlock Text="TRL" Foreground="#93C5FD" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 16 Bytes Hex Digits (High-Density Monospace) -->
                                                        <ui:TextBlock Grid.Column="2" Text="{Binding FormattedHex}" FontFamily="Consolas" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="2,0" />

                                                        <!-- ASCII Preview -->
                                                        <ui:TextBlock Grid.Column="3" Text="{Binding DataAscii}" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />

                                                        <!-- Compact Action Buttons -->
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Icon="{ui:SymbolIcon Edit16}" ToolTip="Edit block" Padding="5,2" Margin="0,0,4,0"
                                                                       Command="{Binding DataContext.EditBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                       CommandParameter="{Binding}" />
                                                            <ui:Button Icon="{ui:SymbolIcon Copy16}" ToolTip="Copy 32-hex data" Padding="5,2"
                                                                       Command="{Binding DataContext.CopyHexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                       CommandParameter="{Binding DataHex}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
