<UserControl x:Class="iceman_gui.Views.EditUidPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="Edit UID" FontTypography="Title" />
                <ui:TextBlock Text="Change only the card UID on a magic card. Data sectors, keys and access conditions are left untouched."
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,4,0,0" />
            </StackPanel>

            <!-- Stepper -->
            <ItemsControl ItemsSource="{Binding Steps}" HorizontalAlignment="Center" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanGo}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="13">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Background" Value="#16A34A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Border Width="42" Height="1" Margin="8,0"
                                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsNotLast, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Focused step -->
            <Grid>
                <!-- Step 1 -->
                <Border Style="{StaticResource FluentEntranceStyle}"
                        Visibility="{Binding IsStep1Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Card>
                        <StackPanel>
                            <ui:TextBlock Text="Read the target card" FontTypography="Subtitle" Margin="0,0,0,10" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button Content="Read target card"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Scan24}"
                                           Command="{Binding ReadTargetCommand}"
                                           IsEnabled="{Binding CanReadTarget}"
                                           Margin="0,0,12,0" />
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                                 Visibility="{Binding IsReadingTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center" />
                            </StackPanel>

                            <ui:TextBlock Text="{Binding TargetStatus}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                </Border>

                <!-- Step 2 -->
                <Border Style="{StaticResource FluentEntranceStyle}"
                        Visibility="{Binding IsStep2Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Card>
                        <StackPanel>
                            <ui:TextBlock Text="Set the new UID" FontTypography="Subtitle" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding NewUid, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="Consolas"
                                            FontSize="16"
                                            MaxLength="8"
                                            PlaceholderText="e.g. 11223344"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                <ui:Button Grid.Column="1"
                                           Content="Random"
                                           Icon="{ui:SymbolIcon Sparkle24}"
                                           Command="{Binding RandomizeUidCommand}"
                                           ToolTip="Generate a random 4-byte UID" />
                            </Grid>

                            <StackPanel Visibility="{Binding ShowKeyA, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:TextBlock Text="Key A (sector 0)"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding KeyA, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="Consolas"
                                            MaxLength="12"
                                            PlaceholderText="FFFFFFFFFFFF" />
                                <ui:TextBlock Text="Usually FFFFFFFFFFFF on blank magic cards."
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              FontSize="11"
                                              Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </Border>

                <!-- Step 3 -->
                <Border Style="{StaticResource FluentEntranceStyle}"
                        Visibility="{Binding IsStep3Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Card>
                        <StackPanel>
                            <ui:TextBlock Text="Write and verify" FontTypography="Subtitle" Margin="0,0,0,10" />

                            <StackPanel Margin="0,0,0,10">
                                <ui:TextBlock Text="{Binding TargetTag.FormattedUid, StringFormat='Current UID: {0}'}"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding NewUid, StringFormat='New UID: {0}'}"
                                              FontFamily="Consolas"
                                              FontTypography="BodyStrong"
                                              Margin="0,2,0,0" />
                                <ui:TextBlock Text="{Binding TargetCapabilities.Summary}"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              FontSize="11"
                                              TextWrapping="Wrap"
                                              Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button Content="Write UID"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding WriteUidCommand}"
                                           IsEnabled="{Binding CanWrite}"
                                           Margin="0,0,12,0" />
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True"
                                                 Visibility="{Binding IsWriting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 VerticalAlignment="Center" />
                            </StackPanel>

                            <ui:TextBlock Text="{Binding Status}"
                                          Foreground="{Binding StatusBrush}"
                                          TextWrapping="Wrap"
                                          Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ui:Card>
                </Border>
            </Grid>

            <!-- Navigation -->
            <Grid Margin="0,16,0,0">
                <ui:Button Content="Back"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Transparent"
                           Command="{Binding PreviousStepCommand}"
                           IsEnabled="{Binding CanGoBack}"
                           HorizontalAlignment="Left"
                           Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="Continue"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding NextStepCommand}"
                           IsEnabled="{Binding CanGoNext}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding ShowContinue, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
