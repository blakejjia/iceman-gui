<UserControl x:Class="iceman_gui.Views.FlasherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <ui:TextBlock Text="Firmware Flasher Assistant" FontTypography="Title" />
                <ui:TextBlock Text="Safely update Proxmark3 ARM Bootrom and FPGA/OS fullimage firmware." 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Verification Card -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Firmware Binary Verification" FontTypography="Subtitle" />
                    </StackPanel>

                    <ui:TextBlock Text="{Binding FirmwareFilesStatus}" FontFamily="Consolas" FontSize="14" Margin="0,0,0,12" />
                    <ui:Button Content="Re-check Files" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding CheckFirmwareCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

            <!-- Flashing Controls Card -->
            <ui:Card Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="Flash Execution" FontTypography="Subtitle" />
                    </StackPanel>

                    <CheckBox Content="Unlock Bootloader (--unlock-bootloader, also updates bootrom.elf)" IsChecked="{Binding UnlockBootloader}" Margin="0,0,0,12" />

                    <ui:InfoBar IsOpen="True" Severity="Warning" Message="Ensure the USB connection is stable during flashing. Do not disconnect the device while flashing is in progress." IsClosable="False" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Start Flashing Firmware" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding FlashCommand}" Margin="0,0,12,0" />
                        <ProgressBar Width="140" Height="6" IsIndeterminate="{Binding IsFlashing}" Visibility="{Binding IsFlashing, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Recovery Guide Expander -->
            <Expander Header="Emergency Recovery Guide (If flashing fails or device is unresponsive)" IsExpanded="False" Margin="0,0,0,20">
                <StackPanel Margin="8">
                    <ui:TextBlock Text="If your Proxmark3 fails to boot or gets disconnected during flashing:" FontWeight="Bold" Margin="0,0,0,6" />
                    <ui:TextBlock Text="1. Unplug the USB cable from the Proxmark3." Margin="0,2" />
                    <ui:TextBlock Text="2. Press and HOLD the physical button on the side of the Proxmark3." Margin="0,2" />
                    <ui:TextBlock Text="3. While continuing to hold the button, plug the USB cable back in." Margin="0,2" />
                    <ui:TextBlock Text="4. Keep holding the button until both red LEDs light up (Bootloader mode)." Margin="0,2" />
                    <ui:TextBlock Text="5. Release the button, select the COM port, and run flash again." Margin="0,2" />
                </StackPanel>
            </Expander>

            <!-- Flasher Log -->
            <ui:Card>
                <StackPanel>
                    <ui:TextBlock Text="Flash Process Log" FontTypography="Subtitle" Margin="0,0,0,8" />
                    <TextBox Text="{Binding FlashLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Background="#111111" Foreground="#00FF66" Height="220" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
