<UserControl x:Class="iceman_gui.Views.TerminalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:TextBlock Text="Interactive Terminal" FontTypography="Title" />
            <ui:TextBlock Text="Full-featured command console directly streaming to proxmark3.exe with ANSI color rendering and command history." 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Quick Action Chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBlock Text="Quick Commands:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
            <ui:Button Content="hw version" Click="QuickCmd_Click" Tag="hw version" Margin="0,0,6,0" />
            <ui:Button Content="hw tune" Click="QuickCmd_Click" Tag="hw tune" Margin="0,0,6,0" />
            <ui:Button Content="auto" Click="QuickCmd_Click" Tag="auto" Margin="0,0,6,0" />
            <ui:Button Content="hf 14a reader" Click="QuickCmd_Click" Tag="hf 14a reader" Margin="0,0,6,0" />
            <ui:Button Content="hf mf chk --1k" Click="QuickCmd_Click" Tag="hf mf chk --1k" Margin="0,0,6,0" />
            <ui:Button Content="Clear" Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearTerminalCommand}" Margin="0,0,6,0" />
            <ui:Button Content="Cancel / Abort" Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCurrentCommand}" />
        </StackPanel>

        <!-- ANSI Terminal RichTextBox -->
        <Border Grid.Row="2" Background="#0C1017" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <RichTextBox x:Name="TerminalBox" 
                         IsReadOnly="True" 
                         Background="Transparent" 
                         Foreground="#C9D1D9" 
                         FontFamily="Consolas, Cascadia Code, Courier New" 
                         FontSize="13" 
                         BorderThickness="0" 
                         VerticalScrollBarVisibility="Auto">
                <FlowDocument PagePadding="0" />
            </RichTextBox>
        </Border>

        <!-- Command Input Bar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="InputBox" 
                        Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}" 
                        PlaceholderText="Type a Proxmark3 command (e.g. hf search, hw status) and press Enter..." 
                        FontFamily="Consolas" 
                        FontSize="14" 
                        KeyDown="InputBox_KeyDown" 
                        Margin="0,0,12,0" />

            <ui:Button Grid.Column="1" 
                       Content="Send" 
                       Appearance="Primary" 
                       Icon="{ui:SymbolIcon Send24}" 
                       Command="{Binding SendCommandCommand}" />
        </Grid>
    </Grid>
</UserControl>
