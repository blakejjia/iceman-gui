<ui:FluentWindow x:Class="iceman_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:iceman_gui.Views"
        xmlns:viewmodels="clr-namespace:iceman_gui.ViewModels"
        Title="iceman-gui"
        Icon="assets/favicon.png"
        Height="800" Width="1120"
        MinHeight="620" MinWidth="880"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="iceman-gui" ShowMaximize="True" ShowMinimize="True" ShowClose="True" Icon="assets/favicon.png" />

        <!-- Main Body: Fluent Navigation Rail + Dynamic Pages -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           CompactPaneLength="54"
                           OpenPaneLength="210"
                           IsPaneOpen="True"
                           Transition="FadeInWithSlide"
                           TransitionDuration="220">

            <!-- Nav Header -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="16,14,14,14">
                    <ui:TextBlock Text="iceman-gui" FontTypography="TitleLarge" FontSize="20" FontWeight="SemiBold" />
                    <ui:TextBlock Text="Proxmark3 Client" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- Progressive Disclosure Menu Items -->
            <ui:NavigationView.MenuItems>
                <!-- Dashboard (Always visible) -->
                <ui:NavigationViewItem x:Name="NavDashboard"
                                       Content="Dashboard"
                                       Tag="dashboard"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Tag Scanner (Visible once machine is connected) -->
                <ui:NavigationViewItem x:Name="NavScanner"
                                       Content="Tag Scanner"
                                       Tag="scanner"
                                       Click="OnNavClick"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <!-- Footer: Native CMD Terminal launch -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Open PM3 Terminal"
                                       Icon="{ui:SymbolIcon WindowConsole20}"
                                       Command="{Binding OpenExternalTerminalCommand}"
                                       ToolTip="Launch native unbuffered CMD running pm3.bat directly"
                                       Tag="terminal" />
            </ui:NavigationView.FooterMenuItems>

            <!-- Page Container Overlay -->
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <!-- Global Activity Bar (fluent indeterminate glowing bar at top of window when any operation is running) -->
                    <ProgressBar Height="2.5"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsAppBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Panel.ZIndex="999" />

                    <!-- Dashboard Page -->
                    <Border Style="{StaticResource FluentEntranceStyle}"
                            Visibility="{Binding IsDashboardActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:DashboardPage DataContext="{Binding Dashboard}" />
                    </Border>

                    <!-- Tag Scanner Page -->
                    <Border Style="{StaticResource FluentEntranceStyle}"
                            Visibility="{Binding IsScannerActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:TagScannerPage DataContext="{Binding TagScanner}" />
                    </Border>

                    <!-- Mifare Toolkit Page -->
                    <Border Style="{StaticResource FluentEntranceStyle}"
                            Visibility="{Binding IsMifareActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:MifareToolkitPage DataContext="{Binding MifareToolkit}" />
                    </Border>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Global Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="LimeGreen" Margin="0,0,8,0" />
                    <ui:TextBlock Text="{Binding ActivePort, StringFormat='Port: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <ui:TextBlock Text="•" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                    <ui:TextBlock Text="Iceman/master RRG" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
