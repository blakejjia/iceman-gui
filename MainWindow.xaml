<ui:FluentWindow x:Class="iceman_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:iceman_gui.Views"
        xmlns:viewmodels="clr-namespace:iceman_gui.ViewModels"
        Title="Proxmark3 Iceman Manager" 
        Height="800" Width="1120"
        MinHeight="620" MinWidth="880"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Proxmark3 Iceman Manager" ShowMaximize="True" ShowMinimize="True" ShowClose="True" />

        <!-- Main Body: Fluent Navigation Rail + Dynamic Pages -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           CompactPaneLength="54"
                           OpenPaneLength="210"
                           IsPaneOpen="True">

            <!-- Nav Header -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="14,12,14,14">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BroadActivityFeed24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <ui:TextBlock Text="PM3 Iceman" FontTypography="Subtitle" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:TextBlock Text="Portable Client GUI" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="28,2,0,0" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <!-- Progressive Disclosure Menu Items -->
            <ui:NavigationView.MenuItems>
                <!-- Dashboard (Always visible) -->
                <ui:NavigationViewItem x:Name="NavDashboard"
                                       Content="Dashboard"
                                       Tag="dashboard"
                                       Click="OnNavClick">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Tag Scanner (Visible once machine is connected) -->
                <ui:NavigationViewItem x:Name="NavScanner"
                                       Content="Tag Scanner"
                                       Tag="scanner"
                                       Click="OnNavClick"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Mifare Toolkit (Visible once a Mifare tag is discovered) -->
                <ui:NavigationViewItem x:Name="NavMifare"
                                       Content="Mifare Toolkit"
                                       Tag="mifare"
                                       Click="OnNavClick"
                                       Visibility="{Binding IsMifareDetected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ContactCard24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Firmware Flasher (Visible once connected) -->
                <ui:NavigationViewItem x:Name="NavFlasher"
                                       Content="Firmware Flasher"
                                       Tag="flasher"
                                       Click="OnNavClick"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- Footer: Native CMD Terminal launch & Port Info -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Open PM3 Terminal"
                                       Icon="{ui:SymbolIcon WindowConsole20}"
                                       Command="{Binding OpenExternalTerminalCommand}"
                                       ToolTip="Launch native unbuffered CMD running pm3.bat directly"
                                       Tag="terminal" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.PaneFooter>
                <Border Margin="10,6" Padding="10,6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel>
                        <ui:TextBlock Text="Connected Port:" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:TextBlock Text="{Binding ActivePort, FallbackValue='COM9'}" FontWeight="Bold" Foreground="LimeGreen" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </ui:NavigationView.PaneFooter>

            <!-- Page Container Overlay -->
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <views:DashboardPage DataContext="{Binding Dashboard}" Visibility="{Binding IsDashboardActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:TagScannerPage DataContext="{Binding TagScanner}" Visibility="{Binding IsScannerActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:MifareToolkitPage DataContext="{Binding MifareToolkit}" Visibility="{Binding IsMifareActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:FlasherPage DataContext="{Binding Flasher}" Visibility="{Binding IsFlasherActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Global Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="LimeGreen" Margin="0,0,8,0" />
                    <ui:TextBlock Text="{Binding ActivePort, StringFormat='Port: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <ui:TextBlock Text="•" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                    <ui:TextBlock Text="Iceman/master RRG" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Stop / Abort Command" Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelExecutionCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
