<ui:FluentWindow x:Class="iceman_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:iceman_gui.Views"
        xmlns:viewmodels="clr-namespace:iceman_gui.ViewModels"
        Title="Proxmark3 Iceman Manager" 
        Height="780" Width="1100"
        MinHeight="600" MinWidth="850"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Proxmark3 Iceman Manager" ShowMaximize="True" ShowMinimize="True" ShowClose="True" />

        <!-- Main Body: Navigation Sidebar + Tab Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Logo / Header -->
                    <StackPanel Grid.Row="0" Margin="16,16,16,20">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BroadActivityFeed24" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                            <ui:TextBlock Text="PM3 Iceman" FontTypography="Subtitle" />
                        </StackPanel>
                        <ui:TextBlock Text="Portable Client GUI" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="32,4,0,0" />
                    </StackPanel>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1" Margin="8,0">
                        <RadioButton x:Name="NavDashboard" IsChecked="True" Style="{DynamicResource DefaultRadioButtonStyle}" GroupName="NavGroup" Margin="0,3" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="18" Margin="0,0,12,0" />
                                <ui:TextBlock Text="Dashboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavScanner" Style="{DynamicResource DefaultRadioButtonStyle}" GroupName="NavGroup" Margin="0,3" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="18" Margin="0,0,12,0" />
                                <ui:TextBlock Text="Tag Scanner" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavMifare" Style="{DynamicResource DefaultRadioButtonStyle}" GroupName="NavGroup" Margin="0,3" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ContactCard24" FontSize="18" Margin="0,0,12,0" />
                                <ui:TextBlock Text="Mifare Toolkit" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFlasher" Style="{DynamicResource DefaultRadioButtonStyle}" GroupName="NavGroup" Margin="0,3" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="18" Margin="0,0,12,0" />
                                <ui:TextBlock Text="Firmware Flasher" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTerminal" Style="{DynamicResource DefaultRadioButtonStyle}" GroupName="NavGroup" Margin="0,3" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WindowConsole20" FontSize="18" Margin="0,0,12,0" />
                                <ui:TextBlock Text="Interactive Terminal" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Nav Info -->
                    <Border Grid.Row="2" Margin="12,8" Padding="10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                        <StackPanel>
                            <ui:TextBlock Text="Target Device:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                            <ui:TextBlock Text="{Binding ActivePort, FallbackValue='COM9'}" FontWeight="Bold" Foreground="LimeGreen" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Page Content Container -->
            <Grid Grid.Column="1">
                <views:DashboardPage DataContext="{Binding Dashboard}" Visibility="{Binding IsChecked, ElementName=NavDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:TagScannerPage DataContext="{Binding TagScanner}" Visibility="{Binding IsChecked, ElementName=NavScanner, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:MifareToolkitPage DataContext="{Binding MifareToolkit}" Visibility="{Binding IsChecked, ElementName=NavMifare, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:FlasherPage DataContext="{Binding Flasher}" Visibility="{Binding IsChecked, ElementName=NavFlasher, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:TerminalPage DataContext="{Binding Terminal}" Visibility="{Binding IsChecked, ElementName=NavTerminal, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <!-- Global Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="LimeGreen" Margin="0,0,8,0" />
                    <ui:TextBlock Text="{Binding ActivePort, StringFormat='Port: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
                    <ui:TextBlock Text="•" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                    <ui:TextBlock Text="Iceman/master RRG" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Stop / Abort Command" Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelExecutionCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
