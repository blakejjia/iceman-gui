<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>iceman_gui</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Authors>iceman-gui contributors</Authors>
    <Description>Modern Windows 11 Fluent UI Client for Proxmark3 (Iceman/RRG)</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <ApplicationIcon>assets\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\favicon.png" />
    <Resource Include="assets\favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="client\**" Exclude="client\.proxmark3\logs\**;client\.proxmark3\history.txt;client\tmp\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="recovery\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="*.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Enforce that published package always bundles the complete Proxmark3 client -->
  <Target Name="ValidatePublishedClient" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)client\proxmark3.exe')"
           Text="Publish verification failed: '$(PublishDir)client\proxmark3.exe' does not exist. The application package must include the bundled Proxmark3 client." />
    <Error Condition="!Exists('$(PublishDir)client\libs\Qt6Core.dll')"
           Text="Publish verification failed: '$(PublishDir)client\libs\Qt6Core.dll' does not exist. The application package must include the bundled client libraries." />
  </Target>

</Project>
